// IMPORTANT:
// RUN WITH: lab-admin (the whole file). The file is re-runnable from top to
// bottom: it drops and recreates every collection it uses.
// Inserts that are EXPECTED TO FAIL are commented out, because in a playground
// the first error stops the rest of the file. To test one of them, uncomment
// it, select its lines and run only those lines, then comment it out again.
// Every command is wrapped in console.log(...), so its result is printed
// in the output after running.


use("clinic");


// ============================================================
// STEP 1 - Create the two validated collections
// RUN WITH: lab-admin
// ============================================================

console.log("STEP 1 drop users:", db.users.drop());
console.log("STEP 1 drop appointments:", db.appointments.drop());

// Result: true / true (false if a collection did not exist yet)

console.log("STEP 1 create users:", db.createCollection("users", {
  validator: {
    $jsonSchema: {
      bsonType: "object",
      required: ["name", "email", "role", "active"],
      properties: {
        // _id must be listed, otherwise additionalProperties: false
        // would reject every document (every document has an _id).
        _id: { bsonType: "objectId" },
        name: { bsonType: "string", minLength: 2, maxLength: 80 },
        email: { bsonType: "string", pattern: "^[^@]+@[^@]+\\.[^@]+$" },
        phone: { bsonType: "string", pattern: "^[0-9+() -]{7,20}$" },
        role: { bsonType: "string", enum: ["doctor", "patient", "admin"] },
        active: { bsonType: "bool" },
        createdAt: { bsonType: "date" },
        doctor: {
          bsonType: "object",
          required: ["specialty", "licenseNo"],
          properties: {
            specialty: { bsonType: "string" },
            licenseNo: { bsonType: "string", pattern: "^MD-\\d{4}$" },
          },
          additionalProperties: false,
        },
        patient: {
          bsonType: "object",
          required: ["birthDate"],
          properties: {
            birthDate: { bsonType: "date" },
            bloodType: {
              bsonType: "string",
              enum: ["A+", "A-", "B+", "B-", "AB+", "AB-", "O+", "O-"],
            },
            allergies: {
              bsonType: "array",
              uniqueItems: true,
              items: { bsonType: "string" },
            },
          },
        },
      },
      additionalProperties: false,
      // Role-dependent rules: one branch per role, exactly one must match.
      oneOf: [
        {
          // doctor: must have doctor {}, must not have patient {}
          properties: { role: { enum: ["doctor"] } },
          required: ["doctor"],
          not: { required: ["patient"] },
        },
        {
          // patient: must have patient {}, must not have doctor {}
          properties: { role: { enum: ["patient"] } },
          required: ["patient"],
          not: { required: ["doctor"] },
        },
        {
          // admin: has neither subdocument
          properties: { role: { enum: ["admin"] } },
          not: { anyOf: [{ required: ["doctor"] }, { required: ["patient"] }] },
        },
      ],
    },
  },
  validationLevel: "strict",
  validationAction: "error",
}));

// Result: { ok: 1 }

console.log("STEP 1 create appointments:", db.createCollection("appointments", {
  validator: {
    $and: [
      {
        $jsonSchema: {
          bsonType: "object",
          required: ["doctorId", "patientId", "start", "durationMin", "reason", "status", "fee"],
          properties: {
            _id: { bsonType: "objectId" },
            doctorId: { bsonType: "objectId" },
            patientId: { bsonType: "objectId" },
            start: { bsonType: "date" },
            durationMin: { bsonType: "number", minimum: 5, maximum: 240 },
            reason: { bsonType: "string", minLength: 3, maxLength: 200 },
            status: { bsonType: "string", enum: ["scheduled", "completed", "cancelled"] },
            fee: { bsonType: "number", minimum: 0 },
            notes: { bsonType: "string" },
            prescriptions: {
              bsonType: "array",
              maxItems: 10,
              items: {
                bsonType: "object",
                required: ["drug", "dose", "days"],
                properties: {
                  drug: { bsonType: "string" },
                  dose: { bsonType: "string" },
                  days: { bsonType: "number", minimum: 1, maximum: 365 },
                },
                additionalProperties: false,
              },
            },
          },
          additionalProperties: false,
        },
      },
      // BONUS (step 6): doctorId and patientId must be different values.
      // $jsonSchema cannot compare two fields, so $expr is combined with it.
      { $expr: { $ne: ["$doctorId", "$patientId"] } },
    ],
  },
  validationLevel: "strict",
  validationAction: "error",
}));

// Result: { ok: 1 }


