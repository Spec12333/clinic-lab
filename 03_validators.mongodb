console.log("STEP 2 counts:", {
  users: db.users.countDocuments(),
  appointments: db.appointments.countDocuments(),
});

// Result: { users: 0, appointments: 0 } - nothing invalid was stored.


// ============================================================
// STEP 3 - Accepted documents: one per role + one appointment
// RUN WITH: lab-admin
// ============================================================

const valid = db.users.insertMany([
  {
    name: "John Smith",
    email: "john@example.com",
    role: "doctor",
    active: true,
    doctor: { specialty: "cardiology", licenseNo: "MD-1234" },
  },
  {
    name: "Anna Brown",
    email: "anna@example.com",
    phone: "+374 99 123456",
    role: "patient",
    active: true,
    patient: {
      birthDate: new Date("1995-05-10"),
      bloodType: "A+",
      allergies: ["peanuts", "milk"],
    },
  },
  {
    name: "Admin User",
    email: "admin@example.com",
    role: "admin",
    active: true,
    createdAt: new Date(),
  },
]);
console.log("STEP 3 insertMany users:", valid);

// Result:
// {
//   acknowledged: true,
//   insertedIds: {
//     '0': ObjectId('...'),
//     '1': ObjectId('...'),
//     '2': ObjectId('...')
//   }
// }

console.log("STEP 3 users:", db.users.find().toArray());

// The appointment uses the ids returned above (doctor = John, patient = Anna).
const validAppt = db.appointments.insertOne({
  doctorId: valid.insertedIds[0],
  patientId: valid.insertedIds[1],
  start: new Date("2025-02-03T09:00:00Z"),
  durationMin: 30,
  reason: "Validator test",
  status: "completed",
  fee: 50,
  notes: "accepted document",
  prescriptions: [{ drug: "paracetamol", dose: "500mg", days: 5 }],
});
console.log("STEP 3 insert appointment:", validAppt);

// Result:
// { acknowledged: true, insertedId: ObjectId('...') }

// Delete the test documents again.
console.log("STEP 3 delete appointment:", db.appointments.deleteMany({ reason: "Validator test" }));

// Result: { acknowledged: true, deletedCount: 1 }

console.log("STEP 3 delete users:", db.users.deleteMany({
  email: { $in: ["john@example.com", "anna@example.com", "admin@example.com"] },
}));

// Result: { acknowledged: true, deletedCount: 3 }


// ============================================================
// STEP 4 - Scratch migration
// RUN WITH: lab-admin
// ============================================================

console.log("STEP 4 drop scratch_migration:", db.scratch_migration.drop());      // leftover from an earlier attempt, not needed
console.log("STEP 4 drop scratch_appointments:", db.scratch_appointments.drop()); // re-runnable

console.log("STEP 4 create scratch_appointments:", db.createCollection("scratch_appointments"));   // no validator

// Result: { ok: 1 }

console.log("STEP 4 insert 3 docs:", db.scratch_appointments.insertMany([
  { status: "scheduled", fee: 100, reason: "Valid old appointment" },
  { status: "done", fee: 200, reason: "Invalid status" },
  { status: "scheduled", fee: -5, reason: "Invalid fee" },
]));

// Result: { acknowledged: true, insertedIds: { '0': ..., '1': ..., '2': ... } }
// -> all three are stored, because there is no validator yet.

// The rules for the scratch collection (used in (i) and (iv)).
const scratchSchema = {
  properties: {
    status: { enum: ["scheduled", "completed", "cancelled"] },
    fee: { bsonType: "number", minimum: 0 },
  },
};

// (i) Add a validator with level moderate and action warn
console.log("(i) collMod moderate/warn:", db.runCommand({
  collMod: "scratch_appointments",
  validator: { $jsonSchema: scratchSchema },
  validationLevel: "moderate",
  validationAction: "warn",
}));

// Result: { ok: 1 }

// (ii) Insert another bad appointment
console.log("(ii) bad insert under warn:", db.scratch_appointments.insertOne({
  status: "done",
  fee: 30,
  reason: "Bad insert under warn",
}));

// Result: { acknowledged: true, insertedId: ObjectId('...') }
// -> With validationAction "warn" the server does not refuse the document;
//    it only writes a "Document would fail validation" warning to the mongod log.

// (iii) Update one of the OLD bad documents (change its reason)
console.log("(iii) update old bad doc:", db.scratch_appointments.updateOne(
  { reason: "Invalid fee" },
  { $set: { reason: "Invalid fee (edited)" } }
));

// Result: { acknowledged: true, matchedCount: 1, modifiedCount: 1, upsertedCount: 0 }
// -> Accepted without any warning. With validationLevel "moderate", updates to
//    documents that were already invalid before the validator existed are not
//    checked at all, so old data can still be edited.

// (iv) List every document that violates the rules
console.log("(iv) violators:", db.scratch_appointments.find({ $nor: [{ $jsonSchema: scratchSchema }] }).toArray());

// Result:
// [
//   { _id: ObjectId('...'), status: 'done', fee: 200, reason: 'Invalid status' },
//   { _id: ObjectId('...'), status: 'scheduled', fee: -5, reason: 'Invalid fee (edited)' },
//   { _id: ObjectId('...'), status: 'done', fee: 30, reason: 'Bad insert under warn' }
// ]
// -> 3 violators. $nor returns the documents that do NOT match the schema.

// (v) Fix the violators, switch to strict + error, repeat the bad insert
console.log("(v) fix status:", db.scratch_appointments.updateMany({ status: "done" }, { $set: { status: "completed" } }));

// Result: { acknowledged: true, matchedCount: 2, modifiedCount: 2, upsertedCount: 0 }

console.log("(v) fix fee:", db.scratch_appointments.updateMany({ fee: { $lt: 0 } }, { $set: { fee: 0 } }));

// Result: { acknowledged: true, matchedCount: 1, modifiedCount: 1, upsertedCount: 0 }

console.log("(v) violators left:", db.scratch_appointments.countDocuments({ $nor: [{ $jsonSchema: scratchSchema }] }));

// Result: 0 - no violators left.

console.log("(v) collMod strict/error:", db.runCommand({
  collMod: "scratch_appointments",
  validationLevel: "strict",
  validationAction: "error",
}));

// Result: { ok: 1 }

// Repeat the bad insert from (ii) - uncomment and run on its own:
// console.log("(v) bad insert again:", db.scratch_appointments.insertOne({
//   status: "done",
//   fee: 30,
//   reason: "Bad insert under warn",
// }));
// Result: MongoServerError: Document failed validation
// -> The same document as in (ii) is now refused.

// (vi) Drop the scratch collection
console.log("(vi) drop scratch_appointments:", db.scratch_appointments.drop());

// Result: true


// ============================================================
// STEP 5 - Inspect validationLevel and validationAction of users
// RUN WITH: lab-admin
// ============================================================

const usersOptions = db.getCollectionInfos({ name: "users" })[0].options;
console.log("STEP 5 users options:", {
  validationLevel: usersOptions.validationLevel,
  validationAction: usersOptions.validationAction,
});

// Result:
// { validationLevel: 'strict', validationAction: 'error' }


// ============================================================
// STEP 6 - BONUS: doctorId and patientId must be different
// RUN WITH: lab-admin
// ============================================================
// The rule is the $expr part of the appointments validator in step 1:
//   { $expr: { $ne: ["$doctorId", "$patientId"] } }
// $jsonSchema checks each field on its own and cannot compare two fields,
// so it is combined with $expr inside $and.

